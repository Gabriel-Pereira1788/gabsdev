# Copy to .env and fill in real values. .env is gitignored - never commit it.

# Fine-grained personal access token, scope: read:user (required for the
# GitHub contribution heatmap on the home page). Recent commits use the same
# token if present, but fall back to unauthenticated public requests.
# Create one at https://github.com/settings/tokens
GITHUB_TOKEN=

# GitHub username the home page's activity section shows. Defaults to
# Gabriel-Pereira1788 if unset.
GITHUB_USERNAME=Gabriel-Pereira1788

# Base URL used for canonical links and OG tags.
BASE_URL=http://localhost:8080

# Base URL used by the RSS feed.
SITE_URL=https://gabsdev.dev

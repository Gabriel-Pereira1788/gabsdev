package pages

import (
	"gabsdev-go/internal/i18n"
	"gabsdev-go/internal/views/components"
	"gabsdev-go/internal/views/layouts"
	"strconv"
)

templ AboutPage(lang i18n.Lang, pathname string, fullPath string, postsCount int) {
	@layouts.Layout(i18n.T(lang, "about.page_title"), i18n.T(lang, "meta.description"), "website", lang, pathname, fullPath) {
		<div class="page enter">

			<div class="min-list-head" style="margin-bottom:32px;border-bottom:none;">
				<span class="lbl">{ i18n.T(lang, "about.title_label") }</span>
			</div>

			<div class="about-grid">
				<div>
					<img
						src="/static/images/pixel-avatar.png"
						alt="Gabriel Pereira"
						width="160"
						height="160"
						style="image-rendering: pixelated;"
					/>
					<p style="font-size:13px;color:var(--text-2);margin-top:12px;">{ "@gabsdev" }</p>
				</div>

				<div>
					<p style="font-size:15px;color:var(--text-1);line-height:1.8;margin-bottom:20px;">
						{ i18n.T(lang, "about.bio1") }
					</p>
					<p style="font-size:15px;color:var(--text-1);line-height:1.8;margin-bottom:20px;">
						{ i18n.T(lang, "about.bio2") }
					</p>

					<div class="about-stats">
						<div class="stat-row">
							<span class="k">{ i18n.T(lang, "about.stat.stack") }</span>
							<span class="v">React Native, TypeScript, Swift, Kotlin, Python</span>
						</div>
						<div class="stat-row">
							<span class="k">{ i18n.T(lang, "about.stat.editor") }</span>
							<span class="v">Zed</span>
						</div>
						<div class="stat-row">
							<span class="k">{ i18n.T(lang, "about.stat.articles") }</span>
							<span class="v">{ strconv.Itoa(postsCount) }</span>
						</div>
						<div class="stat-row">
							<span class="k">{ i18n.T(lang, "about.stat.since") }</span>
							<span class="v">2021</span>
						</div>
					</div>

					<div style="display:flex;gap:18px;margin-top:24px;">
						<a
							href="https://github.com/Gabriel-Pereira1788"
							target="_blank"
							rel="noopener"
							style="display:inline-flex;align-items:center;gap:7px;font-size:13px;color:var(--text-2);"
						>
							@components.PixelIcon("github", 14)
							github
						</a>
						<a
							href="/rss.xml"
							style="display:inline-flex;align-items:center;gap:7px;font-size:13px;color:var(--text-2);"
						>
							@components.PixelIcon("rss", 14)
							rss
						</a>
					</div>
				</div>
			</div>

		</div>
	}
}

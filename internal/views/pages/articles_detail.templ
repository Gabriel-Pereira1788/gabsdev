package pages

import (
	"gabsdev-go/internal/domain"
	"gabsdev-go/internal/i18n"
	"gabsdev-go/internal/utils"
	"gabsdev-go/internal/views/layouts"
	"strconv"
)

templ ArticlesDetailPage(
	lang i18n.Lang,
	pathname string,
	fullPath string,
	post domain.Post,
	renderedContent string,
	toc []utils.TOCItem,
	prev *domain.Post,
	next *domain.Post,
) {
	@layouts.Layout(post.Title, post.Excerpt, "article", lang, pathname, fullPath, false) {
		<div class="page enter">

			<div class="article-head">
				<nav class="breadcrumb">
					<a href={ templ.SafeURL(i18n.Path(lang, "/articles")) }>{ i18n.T(lang, "articles.breadcrumb") }</a>
					<span class="sep">/</span>
					<span>{ post.Title }</span>
				</nav>
				<h1 class="article-title">{ post.Title }</h1>
				<div class="article-meta">
					<span>{ utils.FmtDate(post.Date) }</span>
					<span class="sep">·</span>
					<span>{ strconv.Itoa(post.ReadMin) } { i18n.T(lang, "articles.read_min") }</span>
					<div class="post-tags">
						for _, tag := range post.Tags {
							<a class="tag" href={ templ.SafeURL(i18n.Path(lang, "/articles?tag="+tag)) }>{ tag }</a>
						}
					</div>
				</div>
			</div>

			<div class="article-layout">
				<div class="prose">
					@templ.Raw(renderedContent)
				</div>
				if len(toc) > 0 {
					<nav class="toc">
						<div class="toc-title">{ i18n.T(lang, "article.toc_label") }</div>
						for _, item := range toc {
							<a href={ templ.SafeURL("#" + item.ID) } data-toc={ item.ID } class="toc-link">{ item.Title }</a>
						}
					</nav>
				}
			</div>

			<div class="article-end">
				if prev != nil {
					<a class="end-link" href={ templ.SafeURL(i18n.Path(lang, "/articles/"+prev.Slug)) }>
						<span class="sep">←</span>
						{ prev.Title }
					</a>
				}
				if next != nil {
					<a class="end-link" href={ templ.SafeURL(i18n.Path(lang, "/articles/"+next.Slug)) }>
						{ next.Title }
						<span class="sep">→</span>
					</a>
				}
			</div>

		</div>
		<script>
			(function() {
				var links = {}
				document.querySelectorAll('[data-toc]').forEach(function(a) {
					links[a.dataset.toc] = a
				})
				var obs = new IntersectionObserver(function(entries) {
					entries.forEach(function(e) {
						if (links[e.target.id]) {
							links[e.target.id].classList.toggle('active', e.isIntersecting)
						}
					})
				}, { rootMargin: '-20% 0px -70% 0px' })
				document.querySelectorAll('.prose h2[id]').forEach(function(h) { obs.observe(h) })
			})()
		</script>
	}
}

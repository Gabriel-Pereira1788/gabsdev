func appsJSON(apps []components.AppCase) string {
	for i := range apps {
		if apps[i].Stores == nil {
			apps[i].Stores = []components.AppStore{}
		}
	}
	b, err := json.Marshal(apps)
	if err != nil {
		return "[]"
	}
	return string(b)
}

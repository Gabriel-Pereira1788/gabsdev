package pages

import (
	"gabsdev-go/internal/domain"
	"gabsdev-go/internal/i18n"
	"gabsdev-go/internal/utils"
	"gabsdev-go/internal/views/components"
	"gabsdev-go/internal/views/layouts"
	"strconv"
)

const siteSince = 2021

templ HomePage(lang i18n.Lang, pathname string, fullPath string, posts []domain.Post, tags []string) {
	@layouts.Layout(i18n.T(lang, "home.page_title"), lang, pathname, fullPath) {
		<div class="enter">
			<div class="home-min">
				<div class="obsidian-stage">
					@components.AsciiGabsdev()
				</div>
				<p class="min-tag">{ i18n.T(lang, "site.tagline") }</p>
				<div class="min-meta">
					<span>
						<span class="k">{ strconv.Itoa(len(posts)) }</span> { i18n.T(lang, "home.articles") }
					</span>
					<span class="dot">.</span>
					<span>
						<span class="k">{ strconv.Itoa(len(tags)) }</span> { i18n.T(lang, "home.tags") }
					</span>
					<span class="dot">.</span>
					<span>
						{ i18n.T(lang, "home.since") } <span class="k">{ strconv.Itoa(siteSince) }</span>
					</span>
				</div>
			</div>
			<div class="min-list-wrap">
				<div class="min-list-head">
					<span class="lbl">{ i18n.T(lang, "home.recent") }</span>
					<a href={ templ.SafeURL(i18n.Path(lang, "/articles")) } class="all">{ i18n.T(lang, "home.view_all") }</a>
				</div>
				<div class="min-list">
					for _, post := range recentPosts(posts) {
						<a href={ templ.SafeURL(i18n.Path(lang, "/articles/"+post.Slug)) } class="min-row">
							<span class="min-marker">&gt;</span>
							<p class="min-title">{ post.Title }</p>
							<span class="min-date">{ utils.FmtDate(post.Date) }</span>
						</a>
					}
				</div>
			</div>
		</div>
	}
}

func recentPosts(posts []domain.Post) []domain.Post {
	if len(posts) <= 5 {
		return posts
	}
	return posts[:5]
}

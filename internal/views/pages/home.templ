package pages

import (
	"encoding/json"
	"gabsdev-go/internal/domain"
	"gabsdev-go/internal/i18n"
	"gabsdev-go/internal/utils"
	"gabsdev-go/internal/views/components"
	"gabsdev-go/internal/views/layouts"
)

const placeholderIcon = "data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24'%3E%3Crect width='24' height='24' fill='%232a2a2a'/%3E%3Ctext x='12' y='17' font-size='14' text-anchor='middle' fill='%23888' font-family='monospace'%3E%3F%3C/text%3E%3C/svg%3E"

templ HomePage(lang i18n.Lang, pathname string, fullPath string, posts []domain.Post, activity domain.GitHubActivity) {
	@layouts.Layout(i18n.T(lang, "home.page_title"), i18n.T(lang, "meta.description"), "website", lang, pathname, fullPath, true) {
		<div class="enter">
			<div class="home-min">
				<div class="obsidian-stage">
					@components.AsciiGabsdev()
				</div>
				<div class="hero-grid">
					<div class="hero-copy">
						<p class="hero-kicker">{ i18n.T(lang, "home.kicker") }</p>
						<h1 class="home-headline">{ i18n.T(lang, "home.headline") }</h1>
						<p class="min-tag">{ i18n.T(lang, "home.subheadline") }</p>
						<div class="hero-cta">
							<a href="#contact" class="hero-btn hero-btn-primary">{ i18n.T(lang, "home.cta_secondary") }</a>
						</div>
					</div>
					<div class="hero-phone">
						@components.AppSimulator(lang, appsJSON(portfolioApps(lang)))
					</div>
				</div>
			</div>

			<div class="stack-section">
				<div class="min-list-head" style="margin-bottom:8px;">
					<span class="lbl">{ i18n.T(lang, "home.stack_label") }</span>
				</div>
				<div class="stack-rows">
					<div class="stack-row">
						<div class="stack-group">{ i18n.T(lang, "home.stack.languages") }</div>
						<div class="stack-items">TypeScript, Swift, Kotlin, Python, Go</div>
					</div>
					<div class="stack-row">
						<div class="stack-group">{ i18n.T(lang, "home.stack.mobile") }</div>
						<div class="stack-items">React Native, Nitro Modules</div>
					</div>
					<div class="stack-row">
						<div class="stack-group">{ i18n.T(lang, "home.stack.backend") }</div>
						<div class="stack-items">templ, HTMX, LangGraph, { i18n.T(lang, "home.stack.rag") }, { i18n.T(lang, "home.stack.tooling_extra") }</div>
					</div>
				</div>
			</div>

			@components.GitHubActivity(lang, activity)

			<div class="min-list-wrap">
				<div class="min-list-head">
					<span class="lbl">{ i18n.T(lang, "home.recent") }</span>
					<a href={ templ.SafeURL(i18n.Path(lang, "/articles")) } class="all">{ i18n.T(lang, "home.view_all") }</a>
				</div>
				<div class="min-list">
					for _, post := range recentPosts(posts) {
						<a href={ templ.SafeURL(i18n.Path(lang, "/articles/"+post.Slug)) } class="min-row">
							<span class="min-marker">&gt;</span>
							<p class="min-title">{ post.Title }</p>
							<span class="min-date">{ utils.FmtDate(post.Date) }</span>
						</a>
					}
				</div>
			</div>

			<div class="home-contact" id="contact">
				<div class="min-list-head" style="margin-bottom:20px;">
					<span class="lbl">{ i18n.T(lang, "home.contact_label") }</span>
				</div>
				<p class="contact-line">{ i18n.T(lang, "home.contact_line") }</p>
				<div class="contact-links">
					<a href="https://github.com/Gabriel-Pereira1788" target="_blank" rel="noopener" class="hero-btn">
						@components.PixelIcon("github", 14)
						github
					</a>
					<a href="https://www.linkedin.com/in/gabriel-andrade1788/" target="_blank" rel="noopener" class="hero-btn">
						@components.PixelIcon("linkedin", 14)
						linkedin
					</a>
				</div>
			</div>

			<div class="home-about-full">
				<div class="min-list-head" style="margin-bottom:28px;">
					<span class="lbl">{ i18n.T(lang, "about.title_label") }</span>
				</div>
				<div class="about-grid">
					<img
						src="/static/images/pixel-avatar.png"
						alt="Gabriel Pereira"
						width="160"
						height="160"
						class="avatar"
					/>
					<div>
						<p style="font-size:15px;color:var(--text-1);line-height:1.8;margin-bottom:16px;">
							{ i18n.T(lang, "about.bio1") }
						</p>
						<p style="font-size:15px;color:var(--text-1);line-height:1.8;margin-bottom:16px;">
							{ i18n.T(lang, "about.bio2") }
						</p>
						<p style="font-size:13px;color:var(--text-2);margin-bottom:20px;">
							<span style="color:var(--text-2);">{ i18n.T(lang, "about.stat.stack") }</span>: React Native, TypeScript, Swift, Kotlin, Python
						</p>
						<a href={ templ.SafeURL(i18n.Path(lang, "/about")) } style="font-size:12px;color:var(--text-2);">{ i18n.T(lang, "home.about_cta") } →</a>
					</div>
				</div>
			</div>
		</div>
	}
}

func recentPosts(posts []domain.Post) []domain.Post {
	if len(posts) <= 5 {
		return posts
	}
	return posts[:5]
}


package pages

import (
	"gabsdev-go/internal/domain"
	"gabsdev-go/internal/i18n"
	"gabsdev-go/internal/views/components"
	"gabsdev-go/internal/views/layouts"
)

func getTagLabel(lang i18n.Lang, activeTag string) string {
	if activeTag != "" {
		return "// " + activeTag
	}
	return i18n.T(lang, "articles.title_label")
}

templ ArticlesPage(lang i18n.Lang, pathname string, fullPath string, posts []domain.Post, tags []string, activeTag string) {
	@layouts.Layout("Articles", i18n.T(lang, "meta.description"), "website", lang, pathname, fullPath) {
		<div class="page enter">
			<div class="min-list-head">
				<span class="lbl">{ getTagLabel(lang, activeTag) }</span>
			</div>
			@components.SearchBar(lang, activeTag)
			<div class="post-list" id="post-list">
				for _, post := range posts {
					@components.PostRow(lang, post, activeTag)
				}
			</div>
		</div>
	}
}

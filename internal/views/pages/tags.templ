package pages

import (
	"gabsdev-go/internal/i18n"
	"gabsdev-go/internal/views/layouts"
	"strconv"
)

func getTagCategoryLabel(lang i18n.Lang, tags []string) string {
	if len(tags) == 1 {
		return "1 " + i18n.T(lang, "tags.category_singular")
	}
	return strconv.Itoa(len(tags)) + " " + i18n.T(lang, "tags.category_plural")
}

templ TagsPage(lang i18n.Lang, pathname string, fullPath string, tags []string) {
	@layouts.Layout(i18n.T(lang, "tags.page_title"), i18n.T(lang, "meta.description"), "website", lang, pathname, fullPath) {
		<div class="page enter">
			<div class="min-list-head">
				<span class="lbl">{ i18n.T(lang, "tags.title_label") }</span>
			</div>
			<p class="section-sub">
				{ getTagCategoryLabel(lang, tags) }
			</p>
			<div class="tag-grid">
				for _, tag := range tags {
					<a href={ templ.SafeURL(i18n.Path(lang, "/articles?tag="+tag)) } class="tag-cell">
						<span class="tag-cell-name">{ tag }</span>
					</a>
				}
			</div>
		</div>
	}
}
